// Backtest Blocks strategy language: the text of one strategy block. Generated by npm run generate; do not edit.

start: block

block: line ("\n" line)*
line: WS? (content (WS comment?)? | comment)?
comment: ("#" | "//") COMMENT_TEXT?
content: setting | parameter | definition | rule | for_line | continuation
WS: /[ \t]+/
IDENT: /[A-Za-z_][A-Za-z0-9_]*/
DIGITS: /[0-9]+/
TICKER: /[A-Za-z0-9\^:\/._=-]+/
FOR_TICKER: /[A-Za-z0-9\^\/._=-]+/
DATE: /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
REST: /[^\n]+/
COLUMN_NAME: /[A-Za-z0-9_]+/
QUOTED: /"[^"\n]*"/
COMMENT_TEXT: /[^\n]+/
unsigned: DIGITS ("." DIGITS)? | "." DIGITS
number: "-"? unsigned (WS? "%")?
percent: unsigned WS? "%"
count_or_name: DIGITS | IDENT
number_or_name: unsigned | IDENT
setting: "name" WS? ":" WS? REST | "universe" WS? ":" WS? ticker_list | "symbol" WS? ":" WS? TICKER | "from" WS? ":" WS? DATE | "to" WS? ":" WS? DATE | "data" WS? ":" WS? ("yahoo" | "binance" | "tiingo") | "interval" WS? ":" WS? ("1m" | "3m" | "5m" | "15m" | "30m" | "1h" | "2h" | "4h" | "6h" | "8h" | "12h" | "1d" | "3d" | "1w") | "capital" WS? ":" WS? ("$" WS?)? DIGITS (/[,_]/ DIGITS)* ("." DIGITS)? (WS? /[kKmM]/)? | "costs" WS? ":" WS? unsigned (WS? ("bps" | "bp" | "%"))? | "size" WS? ":" WS? (percent | IDENT) | "rebalance" WS? ":" WS? ("never" | "weekly" | "monthly" | "quarterly" | "yearly") | "benchmark" WS? ":" WS? TICKER | "stop" WS "loss" WS? ":" WS? (percent | (unsigned WS? | IDENT WS) "atr" (WS? "(" WS? number_or_name WS? ")")? | IDENT) | "trailing" WS "stop" WS? ":" WS? (percent | (unsigned WS? | IDENT WS) "atr" (WS? "(" WS? number_or_name WS? ")")? | IDENT) | "take" WS "profit" WS? ":" WS? (percent | (unsigned WS? | IDENT WS) "atr" (WS? "(" WS? number_or_name WS? ")")? | IDENT) | "slippage" WS? ":" WS? unsigned (WS? ("bps" | "bp" | "%"))? | "cash" WS "rate" WS? ":" WS? (percent | TICKER) | "test" WS "from" WS? ":" WS? DATE | "hold" WS? ":" WS? "top" WS count_or_name WS "by" WS expr | "weighting" WS? ":" WS? "inverse" WS "volatility" WS? "(" WS? number_or_name WS? ")" | "risk" WS "per" WS "trade" WS? ":" WS? (percent | IDENT) WS "at" WS (unsigned WS? | IDENT WS) "atr" (WS? "(" WS? number_or_name WS? ")")? | "fill" WS? ":" WS? ("next" WS "open" | "close") | "commission" WS? ":" WS? ("$" WS?)? unsigned (WS "per" WS ("order" | "share"))? (WS? "," WS? ("min" | "max") WS (percent | ("$" WS?)? unsigned))* | "entries" WS? ":" WS? count_or_name | "magnify" WS? ":" WS? ("1m" | "3m" | "5m" | "15m" | "30m" | "1h" | "2h" | "4h" | "6h" | "8h" | "12h" | "1d" | "3d" | "1w") | "borrow" WS "fee" WS? ":" WS? (percent | IDENT) | "margin" WS "rate" WS? ":" WS? (percent | IDENT)
ticker_list: ticker_item (WS? "," WS? ticker_item)*
ticker_item: TICKER (WS percent)?
parameter: IDENT WS? "=" WS? number (WS "in" WS number WS? ".." WS? number (WS "step" WS number)?)?
definition: IDENT WS? "=" WS? expr
rule: ("buy" | "sell" | "add" | "short" | "cover") WS "when" WS expr
for_line: "for" WS ("all" | FOR_TICKER (WS? "," WS? FOR_TICKER)*) WS? ":"
continuation: (symbol_operator WS? | word_operator WS)? expr
expr: operand joined* (WS? symbol_operator | WS word_operator)?
joined: gap_operator operand
gap_operator: WS? symbol_operator WS? | WS word_operator WS
symbol_operator: ">=" | "<=" | "==" | "!=" | ">" | "<" | "=" | "+" | "-" | "*" | "/"
word_operator: "and" | "or" | "above" | "below" | "crosses" WS "above" | "crosses" WS "below" | "crosses" | "between"
operand: prefix* term postfix*
prefix: "not" WS | "-" WS?
postfix: WS? "[" WS? count_or_name WS? "]" | WS "of" WS TICKER | WS ("for" | "within") WS count_or_name WS "bars"
term: number | "(" WS? expr WS? ")" | "not" WS? "(" WS? expr WS? ")" | call | "column" WS? "(" WS? (COLUMN_NAME | QUOTED) WS? ")" | "bars" WS "held" | "entry" WS "price" | "last" WS "entry" WS "price" | "entries" WS "made" | "highest" WS "since" WS "entry" | "lowest" WS "since" WS "entry" | "position" WS "return" | IDENT
call: ("sma" | "ema" | "rsi" | "roc" | "stdev" | "highest" | "lowest" | "atr" | "macd" | "macd_signal" | "bb_upper" | "bb_lower" | "stoch_k" | "stoch_d" | "adx" | "plus_di" | "minus_di" | "cci" | "williams_r" | "mfi" | "obv" | "vwap" | "keltner_upper" | "keltner_lower" | "supertrend" | "supertrend_up" | "wma" | "hma" | "median" | "zscore" | "percent_rank" | "slope" | "correl" | "count" | "bars_since" | "sum" | "dema" | "tema" | "kama" | "aroon_up" | "aroon_down" | "psar" | "cmf" | "linreg" | "rsquared" | "efficiency" | "streak" | "min" | "max" | "abs" | "sqrt" | "log" | "exp" | "if") WS? "(" WS? (expr (WS? "," WS? expr)*)? WS? ")"
