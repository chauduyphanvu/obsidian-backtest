# Backtest Blocks strategy language: the text of one strategy block. Generated by npm run generate; do not edit.

root ::= block
block ::= line ("\n" line)*
line ::= ws? (content (ws comment?)? | comment)?
comment ::= ("#" | "//") comment-text?
content ::= setting | parameter | definition | rule | for-line | continuation
ws ::= [ \t]+
ident ::= [A-Za-z_] [A-Za-z0-9_]*
digits ::= [0-9]+
ticker ::= [A-Za-z0-9^:/._=-]+
for-ticker ::= [A-Za-z0-9^/._=-]+
date ::= [0-9] [0-9] [0-9] [0-9] "-" [0-9] [0-9] "-" [0-9] [0-9]
rest ::= [^\n]+
column-name ::= [A-Za-z0-9_]+
quoted ::= "\"" [^\"\n]* "\""
comment-text ::= [^\n]+
unsigned ::= digits ("." digits)? | "." digits
number ::= "-"? unsigned (ws? "%")?
percent ::= unsigned ws? "%"
count-or-name ::= digits | ident
number-or-name ::= unsigned | ident
setting ::= "name" ws? ":" ws? rest | "universe" ws? ":" ws? ticker-list | "symbol" ws? ":" ws? ticker | "from" ws? ":" ws? date | "to" ws? ":" ws? date | "data" ws? ":" ws? ("yahoo" | "binance" | "tiingo") | "interval" ws? ":" ws? ("1m" | "3m" | "5m" | "15m" | "30m" | "1h" | "2h" | "4h" | "6h" | "8h" | "12h" | "1d" | "3d" | "1w") | "capital" ws? ":" ws? ("$" ws?)? digits ([,_] digits)* ("." digits)? (ws? [kKmM])? | "costs" ws? ":" ws? unsigned (ws? ("bps" | "bp" | "%"))? | "size" ws? ":" ws? (percent | ident) | "rebalance" ws? ":" ws? ("never" | "weekly" | "monthly" | "quarterly" | "yearly") | "benchmark" ws? ":" ws? ticker | "stop" ws "loss" ws? ":" ws? (percent | (unsigned ws? | ident ws) "atr" (ws? "(" ws? number-or-name ws? ")")? | ident) | "trailing" ws "stop" ws? ":" ws? (percent | (unsigned ws? | ident ws) "atr" (ws? "(" ws? number-or-name ws? ")")? | ident) | "take" ws "profit" ws? ":" ws? (percent | (unsigned ws? | ident ws) "atr" (ws? "(" ws? number-or-name ws? ")")? | ident) | "slippage" ws? ":" ws? unsigned (ws? ("bps" | "bp" | "%"))? | "cash" ws "rate" ws? ":" ws? (percent | ticker) | "test" ws "from" ws? ":" ws? date | "hold" ws? ":" ws? "top" ws count-or-name ws "by" ws expr | "weighting" ws? ":" ws? "inverse" ws "volatility" ws? "(" ws? number-or-name ws? ")" | "risk" ws "per" ws "trade" ws? ":" ws? (percent | ident) ws "at" ws (unsigned ws? | ident ws) "atr" (ws? "(" ws? number-or-name ws? ")")? | "fill" ws? ":" ws? ("next" ws "open" | "close") | "commission" ws? ":" ws? ("$" ws?)? unsigned (ws "per" ws ("order" | "share"))? (ws? "," ws? ("min" | "max") ws (percent | ("$" ws?)? unsigned))* | "entries" ws? ":" ws? count-or-name | "magnify" ws? ":" ws? ("1m" | "3m" | "5m" | "15m" | "30m" | "1h" | "2h" | "4h" | "6h" | "8h" | "12h" | "1d" | "3d" | "1w") | "borrow" ws "fee" ws? ":" ws? (percent | ident) | "margin" ws "rate" ws? ":" ws? (percent | ident)
ticker-list ::= ticker-item (ws? "," ws? ticker-item)*
ticker-item ::= ticker (ws percent)?
parameter ::= ident ws? "=" ws? number (ws "in" ws number ws? ".." ws? number (ws "step" ws number)?)?
definition ::= ident ws? "=" ws? expr
rule ::= ("buy" | "sell" | "add" | "short" | "cover") ws "when" ws expr
for-line ::= "for" ws ("all" | for-ticker (ws? "," ws? for-ticker)*) ws? ":"
continuation ::= (symbol-operator ws? | word-operator ws)? expr
expr ::= operand joined* (ws? symbol-operator | ws word-operator)?
joined ::= gap-operator operand
gap-operator ::= ws? symbol-operator ws? | ws word-operator ws
symbol-operator ::= ">=" | "<=" | "==" | "!=" | ">" | "<" | "=" | "+" | "-" | "*" | "/"
word-operator ::= "and" | "or" | "above" | "below" | "crosses" ws "above" | "crosses" ws "below" | "crosses" | "between"
operand ::= prefix* term postfix*
prefix ::= "not" ws | "-" ws?
postfix ::= ws? "[" ws? count-or-name ws? "]" | ws "of" ws ticker | ws ("for" | "within") ws count-or-name ws "bars"
term ::= number | "(" ws? expr ws? ")" | "not" ws? "(" ws? expr ws? ")" | call | "column" ws? "(" ws? (column-name | quoted) ws? ")" | "bars" ws "held" | "entry" ws "price" | "last" ws "entry" ws "price" | "entries" ws "made" | "highest" ws "since" ws "entry" | "lowest" ws "since" ws "entry" | "position" ws "return" | ident
call ::= ("sma" | "ema" | "rsi" | "roc" | "stdev" | "highest" | "lowest" | "atr" | "macd" | "macd_signal" | "bb_upper" | "bb_lower" | "stoch_k" | "stoch_d" | "adx" | "plus_di" | "minus_di" | "cci" | "williams_r" | "mfi" | "obv" | "vwap" | "keltner_upper" | "keltner_lower" | "supertrend" | "supertrend_up" | "wma" | "hma" | "median" | "zscore" | "percent_rank" | "slope" | "correl" | "count" | "bars_since" | "sum" | "dema" | "tema" | "kama" | "aroon_up" | "aroon_down" | "psar" | "cmf" | "linreg" | "rsquared" | "efficiency" | "streak" | "min" | "max" | "abs" | "sqrt" | "log" | "exp" | "if") ws? "(" ws? (expr (ws? "," ws? expr)*)? ws? ")"
